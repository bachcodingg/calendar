{
  "name": "semester-control-deck",
  "version": "2.0.0",
  "private": true,
  "description": "Exam and coursework control system: three date states, a study planner that allocates real hours, and a logged study-time ledger.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --force",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
